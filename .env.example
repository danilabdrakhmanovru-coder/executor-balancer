# Скопируйте в .env и замените значения (или сгенерируйте командой из README)
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
INTEGRATION_API_KEY=change-me-at-least-24-random-chars
AIS_API_KEY=change-me-at-least-24-random-chars
ADMIN_PASSWORD=change-me-12-chars-min
SWAGGER_ENABLED=true
# ---- демонстрация: две строки ниже включают эмулятор АИС и вкладку «Тестовый стенд» ----
# для боевого запуска удалите обе строки и задайте AIS_BASE_URL — адрес настоящей АИС
COMPOSE_PROFILES=demo
DEMO_ENABLED=true
# AIS_BASE_URL=https://ais.example.local
# ---- гостевой вход без пароля (жюри по ссылке): Viewer — только просмотр, Manager — можно пробовать; пусто — выключен ----
# GUEST_ACCESS=Viewer
# ---- сайт в интернете (docs/DEPLOY.md): Caddy с HTTPS для домена; профиль public добавить в COMPOSE_PROFILES ----
# COMPOSE_PROFILES=demo,public
# DOMAIN=balancer-team.ru
# PROXY_ENABLED=true
# ---- ИИ-разбор заявок (необязательно): любая модель с OpenAI-совместимым API ----
# в модель уходит только обезличенная сводка по заявкам отдела; без этих строк вкладка «Разбор заявок» считает цифры без ИИ
# своя модель на этом компьютере (Ollama):  AI_BASE_URL=http://host.docker.internal:11434/v1  AI_MODEL=qwen2.5:7b  AI_TIMEOUT_SECONDS=300  AI_MAX_TOKENS=900
# Yandex AI Studio:  AI_BASE_URL=https://llm.api.cloud.yandex.net/v1  AI_MODEL=gpt://<каталог>/yandexgpt/latest  AI_PROJECT=<каталог>  AI_API_KEY=<ключ>
# другой провайдер:  его адрес /v1, имя модели и ключ; ключ — только здесь, не в git и не в мессенджерах
# AI_BASE_URL=
# AI_MODEL=
# AI_PROJECT=
# AI_API_KEY=
# AI_TIMEOUT_SECONDS=90
# AI_MAX_TOKENS=1500
